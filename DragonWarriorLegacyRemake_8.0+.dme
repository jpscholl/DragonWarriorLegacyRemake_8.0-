// DM Environment file for DragonWarriorLegacyRemake_8.0+.dme.
// All manual changes should be made outside the BEGIN_ and END_ blocks.
// New source code should be placed in .dm files: choose File/New --> Code File.

// BEGIN_INTERNALS
// END_INTERNALS

// BEGIN_FILE_DIR
#define FILE_DIR .
#define FILE_DIR "Mob Icons"
#define FILE_DIR "Mob Icons/Custom GM"
#define FILE_DIR "Mob Icons/Monsters"
#define FILE_DIR "Mob Icons/NPC"
#define FILE_DIR "Mob Icons/Player"
#define FILE_DIR "Sound & Music"
#define FILE_DIR "UI & Effects"
#define FILE_DIR "World Icons"
#define FILE_DIR "World Icons/Items"
// END_FILE_DIR

// BEGIN_PREFERENCES
// END_PREFERENCES
#define TILE_WIDTH 32
#define TILE_HEIGHT 32
// Shared vertical sprite offset (players AND enemies) — defined here, not in a .dm
// file, so it's available regardless of #include order below (Combat/NPCs/EnemyNPCs.dm
// compiles before Core/Main.dm alphabetically, same reason TILE_WIDTH/TILE_HEIGHT live here).
#define SPRITE_PIXEL_Y_OFFSET 7

// Dedicated channel for one-shot combat/event SFX (attack/hit/dodge/stairs/fall, etc.)
// — area background music (PlayAreaMusic(), Area.dm) plays on channel 1, and playing
// any other sound on that same channel interrupts/replaces the music. Also defined
// here rather than Main.dm for the same #include-order reason as SPRITE_PIXEL_Y_OFFSET
// above (Combat/CombatSystem.dm needs this and compiles before Core/Main.dm too).
#define SFX_CHANNEL 3

// EMERGENCY FALLBACK ONLY as of the area-based spawn system (GetPlayerSpawnTurf()/
// GetRespawnTurf(), Code/World/Area.dm) — the real spawn/respawn points are now
// wherever a host places an area/playerStart or area/respawnPoint instance on their
// map, not this coordinate. FindSpawnTurf() (Area.dm) only falls back to this if a
// map has no such area at all, so an old/incomplete map doesn't strand a player.
// Same #include-order reason as SPRITE_PIXEL_Y_OFFSET/SFX_CHANNEL above —
// Combat/Skills/SkillCatalog.dm's Return skill needs PLAYER_SPAWN (indirectly, via
// Area.dm's fallback) and compiles before Core/Main.dm (where this used to live
// exclusively) alphabetically.
#define PLAYER_SPAWN locate(26, 8, 4)

// How many save slots each player gets. Same #include-order reason as the others
// above — Admin/Commands/GMCommands.dm's GM_Ban ban-list scan needs this and
// compiles before Core/Main.dm (where this used to live exclusively) alphabetically.
// Shared across LoginMenu.dm/SaveSystem.dm/GMCommands.dm so all three stay in sync.
#define MAX_CHARACTERS 4

// Max character name length, shared by LoginMenu.dm's PromptForName() (character
// creation) and Admin/Commands/GMCommands.dm's GM_NameChange(). Same #include-order
// reason as the others above — GMCommands.dm compiles before Core/Main.dm (where
// this used to live exclusively) alphabetically.
#define MAX_NAME_LENGTH 24

// Layer used for any area's icon/icon_state rendered as a real overlay — shared by
// GM_SeeAreas' debug overlay (RefreshAreaOverlay(), Admin/Commands/GMCommands.dm) and
// area/AddedTurf()'s always-on decoration (Code/World/Area.dm), both above mobs'
// default layer 4. Lives here rather than in Area.dm itself for the same #include-order
// reason as the others above — GMCommands.dm compiles before World/Area.dm
// alphabetically, and a single shared define means the two overlay systems can never
// drift apart from each other.
#define AREA_OVERLAY_LAYER 5

// Plain floating damage numbers (not crit/heal/miss, see their own colors at each
// ShowCombatNumber() call site, Code/UI/HUD.dm) — darker than pure #ff0000 so the
// white-glyph-tinted text stays legible against bright map tiles instead of blowing
// out. Lives here rather than in HUD.dm itself for the same #include-order reason as
// the others above — Combat/CombatSystem.dm, Combat/StatusEffects.dm, and
// World/Turfs.dm all use this and compile before UI/HUD.dm alphabetically.
#define DAMAGE_NUMBER_COLOR "#cc0000"

// Cast windup speed, shared by every spell that plays a castmeter.dmi (icon_states "1"
// through "10") windup — Blaze (Combat/Skills/SkillDatum.dm) and GenericSpell's healing
// branch (Combat/Skills/SkillCatalog.dm, PlayHealCastSequence(), Combat/CombatSystem.dm)
// both use it, so a single shared value keeps the windup feel consistent across spells
// instead of two independently-tuned numbers drifting apart. Total windup = 10 frames *
// frameDelay, so at this divisor a fresh level-1 caster winds up in a bit over a second,
// and a high-Intelligence one noticeably faster. Bigger divisor = snappier cast. Lives
// here rather than in SkillDatum.dm for the same #include-order reason as the others
// above — Combat/CombatSystem.dm and Combat/Skills/SkillCatalog.dm both compile before
// Combat/Skills/SkillDatum.dm alphabetically.
#define CAST_METER_SPEED_DIVISOR 10
#define CAST_METER_MIN_FRAME_DELAY 0.5

// heal/healmore/healmost (spells.dmi) are all a real 4-frame animation (1 decisecond
// per frame, rewind=1 — confirmed via the .dmi's own frame data, not guessed) that
// plays forward then back once per full cycle: 4 frames * 1 decisecond, doubled for the
// rewind, = 8 deciseconds total. PlayHealCastSequence() (CombatSystem.dm) holds the
// overlay on-screen for exactly this long before removing it and applying the heal, so
// the number pop always lands right as the animation finishes rather than cutting it
// off early or leaving a dead pause after.
#define HEAL_ANIM_DURATION 8

// Character-creation step constants (originally only in Code\UI\LoginMenu.dm, which
// still owns the real creation flow). Same #include-order reason as the others above —
// Code\Player\PlayerTemplate.dm's RunSageReclassFlow() needs these too (it reuses
// LoginMenu.dm's IconSelect()/CustomizeColors()/StatAllocation() for Classchange's real
// OG behavior — a full re-run of icon/color/stat selection, not a stat carry-over) and
// compiles before Code\UI\LoginMenu.dm alphabetically.
#define STEP_NAME   1
#define STEP_CLASS  2
#define STEP_ICON   3
#define STEP_CUSTOM 4
#define STEP_STATS  5

